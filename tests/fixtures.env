# Committed test fixtures — expected sizes + md5s for the clean-clone test app.
#
# These pin the EXACT bytes a stock `mix phx.new` app (Phoenix 1.7.24, the version
# pinned by tests/setup-test-app.sh) serves, so the suite asserts content, not status.
# The sendfile regression served app.js as 200 with content-length 125737 but a
# 231-byte body; this file is what turns that into a hard FAIL.
#
# Regenerate with:  tests/setup-test-app.sh --print-fixtures   (after a stock build)

# --- Phoenix 1.7.24 stock digested assets (served via Plug.Static -> sendfile) ---
APP_JS_SIZE=125737
APP_JS_MD5=4db9fcaa846f6ccdd7b41c6b18e99419
APP_CSS_SIZE=24703
APP_CSS_MD5=f8a5443d8c07b13b93aea499ce32f517

# --- Large static asset (exercises sendfile partial-write / -EAGAIN / POLLOUT
#     across MANY TX windows; the 125 KB case may not be enough on a fat window).
#     tests/setup-test-app.sh writes priv/static/assets/big.bin = 1500000 bytes of
#     the 0..255 pattern (varied, never all-X — an all-X body can't detect
#     reordering/duplication, this bug's exact signature). ---
BIG_BIN_PATH=/assets/big.bin
BIG_BIN_SIZE=1500000
BIG_BIN_MD5=0cc66e4b57389c8bead4a68218839a96

# --- Multi-send test routes (test-only controller added to the stock app):
#       /sz/:n      -> inline send_resp of vbody(n)         (Bandit inline path)
#       /chk/:n/:k  -> send_chunked, k chunks of vbody(n)   (multi-send path)
#     vbody(n) = first n bytes of the 0..255 pattern; md5s below. ---
SZ_130000_MD5=dd1a6b008b305b33bfe697f0abf821e1
CHK_8192_4_MD5=6556112372898c69e1de0bf689d8db26
CHK_65536_8_MD5=8f1445bafe2c2095044af7789462f475
CHK_130000_16_MD5=dd1a6b008b305b33bfe697f0abf821e1

# --- Concurrency ---
CONCURRENCY=25
